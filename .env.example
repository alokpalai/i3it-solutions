# Copy to .env and fill in real values before running anything that needs
# a database or auth — none of these have real values anywhere in this
# repo (.env itself is gitignored).

# PostgreSQL connection string. No live database is provisioned yet.
DATABASE_URL="postgresql://user:password@localhost:5432/i3it_platform?schema=public"

# Auth.js — generate with `npx auth secret` (or `openssl rand -base64 32`).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Only used once, by prisma/seed.ts, to create the first Super Admin user.
# Leave unset to skip creating one (seed script logs that it skipped).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Phase 3G — email delivery (src/lib/email.ts). Unset = logs only, no send.
EMAIL_PROVIDER=""
CONTACT_RECIPIENT_EMAIL=""
RFQ_RECIPIENT_EMAIL=""

# Phase 3G — spam protection (src/config/spamProtection.ts). Unset = no
# widget rendered.
NEXT_PUBLIC_SPAM_PROTECTION_PROVIDER=""
NEXT_PUBLIC_SPAM_PROTECTION_SITE_KEY=""
